# Copy this file to ".env" (same folder) and fill in your values. ".env" is never uploaded to GitHub.

# --- AI (free) – https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Publishing to your FREE Cloudflare Pages account
# Token: Cloudflare → My Profile → API Tokens → Create Token → Account policy → Cloudflare Pages: Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Project names → https://<name>.pages.dev  (Cloudflare adds a suffix if the name is taken)
PINPAGE_DEMOS_PROJECT=pinpage-demos
PINPAGE_SITE_PROJECT=pinpage

# --- Your contact details (used on the PinPage site and the demo "Remove" link)
# WhatsApp number with country code, digits only, e.g. 919876543210
PINPAGE_WHATSAPP=
PINPAGE_EMAIL=
# Your name, shown in the "note from the founder" popup (leave empty to show "the founder of Indrix")
PINPAGE_FOUNDER=
# Parent company name shown on the PinPage site
PINPAGE_COMPANY=Indrix
# Google Form link for the waitlist
PINPAGE_WAITLIST_URL=https://forms.gle/xryvJ6mhN9v4SrgX9

# --- Optional
# GOOGLE_PLACES_API_KEY=      real photos, reviews, opening hours (Google Cloud billing account required)
# PORT=3000
